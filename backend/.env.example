# Gemini API anahtari (https://aistudio.google.com/apikey - ucretsiz katman).
# Bos birakilirsa veya gecersizse sistem otomatik olarak mock GM'e (data/gmFlavor.js) duser.
GEMINI_API_KEY=

# Kullanilacak Gemini modeli (opsiyonel, varsayilan: gemini-3.6-flash).
GEMINI_MODEL=

# Backend port (opsiyonel, varsayilan: 3001).
PORT=3001

# Postgres baglanti string'i (opsiyonel). BOS birakilirsa (yerel gelistirme
# icin normal) backend otomatik olarak SQLite'a (game.db dosyasi) duser -
# Postgres kurmaya gerek yok. Sadece prod/Render'da (render.yaml) kullaniliyor.
DATABASE_URL=

# DATABASE_URL ile Postgres'e baglanirken SSL sertifika dogrulamasi
# (opsiyonel, varsayilan: true/rejectUnauthorized:false). "false" yazilirsa
# SSL tamamen kapatilir - cogu managed Postgres (Render dahil) icin varsayilan
# yeterli, bunu degistirmeye normalde gerek yok.
DATABASE_SSL=

# SQLite dosyasinin yolunu override eder (opsiyonel). Bos birakilirsa
# backend/game.db kullanilir (test kosumlarinda - VITEST=true - otomatik
# olarak :memory: kullanilir, bu degiskene gerek kalmadan). Cogu durumda
# hic dokunmaya gerek yok, sadece ozel bir yerel kurulum icin var.
DB_PATH=

# CORS icin izinli frontend origin'leri (opsiyonel, virgulle ayrilmis).
# Yerel dev origin'leri (http://localhost:5173, http://127.0.0.1:5173) zaten
# her zaman izinli, bu degisken SADECE bunlara EK origin'ler icin (ornegin
# prod frontend URL'i, render.yaml'da sabit deger olarak ayarli).
FRONTEND_ORIGIN=

# Kimliksiz-erisilebilir uc noktalarda (karakter olusturma, zar atma, sohbet,
# saldiri/buyu/esya vb.) IP basina dakikalik istek siniri (opsiyonel,
# varsayilan: 20). Test kosumlarinda (VITEST=true) tamamen devre disi.
PUBLIC_RATE_LIMIT_MAX=

# Gemini (AI Game Master) cagrilari icin TUM oyunculara paylasilan saatlik
# ust sinir (opsiyonel, varsayilan: 30) - ucretsiz Gemini katmaninin kotasini
# korumak icin. Asilirsa sessizce mock GM'e duser, hata vermez.
AI_HOURLY_LIMIT=
